# Copie para .env e preencha. Nenhuma dessas chaves é paga (free tier).
# Se existir ~/.secrets/keys.env (ou o caminho em SECRETS_FILE), as chaves
# vêm de lá primeiro — este .env só preenche o que faltar no ficheiro central.
# Cascata de LLM (tenta cada PROVEDOR nesta ordem; dentro de cada provedor,
# roda em rodízio entre TODAS as chaves listadas — separe por vírgula ou uma
# por linha. Múltiplas chaves = mais cota grátis somada, mesmo padrão do
# ariaBot).
XAI_API_KEYS=
GROQ_API_KEYS=
CEREBRAS_API_KEYS=
OPENROUTER_API_KEYS=
MISTRAL_API_KEYS=
GEMINI_API_KEYS=

# Cloudflare Workers AI (grátis: 10 mil "neurons"/dia por conta, zera 00:00
# UTC) — imagem (FLUX schnell, ~50 neurons cada), texto e visão de reserva.
# Cada item é ACCOUNT_ID:API_TOKEN (token com permissão "Workers AI");
# várias contas separadas por vírgula somam cota.
# https://dash.cloudflare.com -> Workers AI -> "Use REST API"
CLOUDFLARE_AI_KEYS=

# Geração de imagem — reserva depois do Cloudflare (a chave paga ficou sem
# saldo e o anônimo passou a responder 402 em 06/10)
# Também aceita múltiplas chaves separadas por vírgula.
POLLINATIONS_API_KEYS=

# Filmagem/foto real de banco de vídeo (grátis, licença Pexels — uso
# comercial livre, sem exigir atribuição). Sem chave, o pipeline cai
# direto pra imagem gerada por IA (ver src/stock_media.py). Criar conta
# grátis em https://www.pexels.com/api/ pra pegar a chave.
PEXELS_API_KEYS=

# 2º banco de vídeo/foto grátis (licença Pixabay, uso comercial livre),
# usado quando o Pexels não tem nada no contexto da cena.
# https://pixabay.com/api/docs/ (a chave aparece logado, na própria página)
PIXABAY_API_KEYS=

# Busca real na internet (grátis, free tier — Tavily é voltado pra
# grounding de LLM). Usada quando um tema é digitado à mão no painel, pra
# ancorar o roteiro em fato real com fonte em vez de só "conhecimento
# geral" do LLM. Hoje todo tema sem dado real busca fonte, e a revisão
# confere nomes — sem chave ou sem cota (1.000/mês por chave), cai no
# DuckDuckGo (grátis, sem chave). https://tavily.com
TAVILY_API_KEYS=

# YouTube Data API v3 — gerado na Fase 0 (Google Cloud Console)
YOUTUBE_CLIENT_SECRET_FILE=credentials/client_secret.json
