# Copie para .env e preencha. Nenhuma dessas chaves é paga (free tier).
# Cascata de LLM (tenta cada PROVEDOR nesta ordem; dentro de cada provedor,
# roda em rodízio entre TODAS as chaves listadas — separe por vírgula ou uma
# por linha. Múltiplas chaves = mais cota grátis somada, mesmo padrão do
# ariaBot).
XAI_API_KEYS=
GROQ_API_KEYS=
CEREBRAS_API_KEYS=
OPENROUTER_API_KEYS=
MISTRAL_API_KEYS=
GEMINI_API_KEYS=

# Geração de imagem (grátis; sem chave usa o endpoint anônimo com modelo mais fraco)
# Também aceita múltiplas chaves separadas por vírgula.
POLLINATIONS_API_KEYS=

# Filmagem/foto real de banco de vídeo (grátis, licença Pexels — uso
# comercial livre, sem exigir atribuição). Sem chave, o pipeline cai
# direto pra imagem gerada por IA (ver src/stock_media.py). Criar conta
# grátis em https://www.pexels.com/api/ pra pegar a chave.
PEXELS_API_KEYS=

# Busca real na internet (grátis, free tier — Tavily é voltado pra
# grounding de LLM). Usada quando um tema é digitado à mão no painel, pra
# ancorar o roteiro em fato real com fonte em vez de só "conhecimento
# geral" do LLM. Sem chave, o roteiro segue sem essa busca (comportamento
# antigo). Criar conta grátis em https://tavily.com pra pegar a chave.
TAVILY_API_KEYS=

# YouTube Data API v3 — gerado na Fase 0 (Google Cloud Console)
YOUTUBE_CLIENT_SECRET_FILE=credentials/client_secret.json
